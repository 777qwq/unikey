#!/bin/sh
JB=$(ls -d /var/containers/Bundle/Application/.jbroot-* 2>/dev/null | head -1)

# 1. App侧过滤器（Classes=UIApplication）
PLIST="$JB/Library/MobileSubstrate/DynamicLibraries/UniKeyApp.plist"
chflags nouchg "$PLIST" 2>/dev/null
rm -f "$PLIST" 2>/dev/null
cat > "$PLIST" <<'PLEOF'
{ Filter = { Classes = ("UIApplication"); }; }
PLEOF
chmod 644 "$PLIST"

# 2. 清理 2.8.x 佳影守护进程实验残留（还原 plist）
DP="$JB/Library/LaunchDaemons/com.zjx.ldysdaemon.plist"
if [ -f "$DP" ]; then
    chflags nouchg "$DP" 2>/dev/null
    plutil -remove EnvironmentVariables "$DP" 2>/dev/null
fi

exit 0
