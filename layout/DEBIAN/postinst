#!/bin/sh
LOG=/rootfs/var/mobile/unikey_postinst.log
echo "[postinst] start $(date)" >> $LOG
rm -f /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp /rootfs/var/mobile/unikey_out.tmp
touch /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp /rootfs/var/mobile/unikey_out.tmp
# 找可用的提取工具
PB=""
for CAND in /var/jb/usr/libexec/PlistBuddy /rootfs/var/jb/usr/libexec/PlistBuddy /usr/libexec/PlistBuddy; do
  [ -x "$CAND" ] && PB="$CAND" && break
done
echo "[postinst] PlistBuddy=$PB" >> $LOG
echo "{ Filter = { Bundles = (" > /rootfs/var/mobile/unikey_out.tmp
JB=$(ls -d /var/containers/Bundle/Application/.jbroot-* 2>/dev/null | head -1)
echo "[postinst] JB=$JB" >> $LOG
NB=0; NE=0
for BASE in "$JB/Applications" "/var/containers/Bundle/Application" "/rootfs/var/containers/Bundle/Application" "/var/staged_system_apps" "/rootfs/var/staged_system_apps" "/var/jb/Applications" "/rootfs/var/jb/Applications"; do
  for APPDIR in "$BASE"/*/*.app; do
    [ -d "$APPDIR" ] || continue
    INFO="$APPD/Info.plist"
    BID=""; EXE=""
    if [ -n "$PB" ]; then
      BID=$("$PB" -c 'Print :CFBundleIdentifier' "$INFO" 2>/dev/null)
      EXE=$("$PB" -c 'Print :CFBundleExecutable' "$INFO" 2>/dev/null)
    fi
    if [ -z "$BID" ]; then
      # 免依赖方案：复制→转XML→grep
      cp "$INFO" /rootfs/var/mobile/unikey_info.tmp 2>/dev/null
      plutil -convert xml1 /rootfs/var/mobile/unikey_info.tmp 2>/dev/null
      BID=$(grep -A1 '<key>CFBundleIdentifier</key>' /rootfs/var/mobile/unikey_info.tmp 2>/dev/null | grep -o '<string>[^<]*</string>' | head -1 | sed 's/<[^>]*>//g')
      EXE=$(grep -A1 '<key>CFBundleExecutable</key>' /rootfs/var/mobile/unikey_info.tmp 2>/dev/null | grep -o '<string>[^<]*</string>' | head -1 | sed 's/<[^>]*>//g')
    fi
    case "$BID" in
      *.*) grep -q "\"$BID\"," /rootfs/var/mobile/unikey_tb.tmp || { echo "\"$BID\"," >> /rootfs/var/mobile/unikey_tb.tmp; NB=$((NB+1)); } ;;
    esac
    case "$EXE" in
      *[A-Za-z]*) LE=$(echo "$EXE" | tr 'A-Z' 'a-z'); grep -q "\"$LE\"," /rootfs/var/mobile/unikey_te.tmp || { echo "\"$LE\"," >> /rootfs/var/mobile/unikey_te.tmp; NE=$((NE+1)); } ;;
    esac
  done
done
echo "[postinst] found bundles=$NB execs=$NE" >> $LOG
echo "Executables = (" >> /rootfs/var/mobile/unikey_out.tmp
cat /rootfs/var/mobile/unikey_te.tmp >> /rootfs/var/mobile/unikey_out.tmp
echo "); }; }" >> /rootfs/var/mobile/unikey_out.tmp
sed -i '1s/.*//' /rootfs/var/mobile/unikey_out.tmp
printf '{ Filter = { Bundles = (\n' > /rootfs/var/mobile/unikey_final.tmp
cat /rootfs/var/mobile/unikey_out.tmp >> /rootfs/var/mobile/unikey_final.tmp
cp /rootfs/var/mobile/unikey_final.tmp "$JB/Library/MobileSubstrate/DynamicLibraries/UniKeyApp.plist" 2>> $LOG
echo "[postinst] whitelist written cp_exit=$?" >> $LOG
chmod 644 "$JB/Library/MobileSubstrate/DynamicLibraries/UniKeyApp.plist" 2>> $LOG
rm -f /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp /rootfs/var/mobile/unikey_out.tmp /rootfs/var/mobile/unikey_final.tmp /rootfs/var/mobile/unikey_info.tmp
echo "[postinst] done" >> $LOG
exit 0
