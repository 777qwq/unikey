#!/bin/sh
LOG=/rootfs/var/mobile/unikey_postinst.log
echo "[postinst] start $(date)" >> $LOG
rm -f /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp /rootfs/var/mobile/unikey_out.tmp
touch /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp
echo "{ Filter = { Bundles = (" > /rootfs/var/mobile/unikey_out.tmp
NB=0; NE=0
for BASE in "$JB/Applications" "/var/containers/Bundle/Application" "/rootfs/var/containers/Bundle/Application" "/var/staged_system_apps" "/rootfs/var/staged_system_apps" "/var/jb/Applications" "/rootfs/var/jb/Applications"; do
  for APPDIR in "$BASE"/*/*.app; do
    [ -d "$APPDIR" ] || continue
    BID=""; EXE=""
    if [ -x /usr/libexec/PlistBuddy ]; then
      BID=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APPDIR/Info.plist" 2>/dev/null)
      EXE=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$APPDIR/Info.plist" 2>/dev/null)
    fi
    if [ -z "$BID" ] && [ -x /usr/bin/plutil ]; then
      BID=$(plutil -extract CFBundleIdentifier raw "$APPDIR/Info.plist" 2>/dev/null)
      EXE=$(plutil -extract CFBundleExecutable raw "$APPDIR/Info.plist" 2>/dev/null)
    fi
    case "$BID" in
      *.*) echo "\"$BID\"," >> /rootfs/var/mobile/unikey_tb.tmp; NB=$((NB+1)) ;;
    esac
    case "$EXE" in
      *[A-Za-z]*) echo "\"$(echo "$EXE" | tr 'A-Z' 'a-z')\"," >> /rootfs/var/mobile/unikey_te.tmp; NE=$((NE+1)) ;;
    esac
  done
done
if [ "$NB" -eq 0 ]; then
  for BASE in "/var/containers/Bundle/Application" "/rootfs/var/containers/Bundle/Application" "$JB/Applications"; do
    echo "[postinst] base=$BASE contents:" >> $LOG
    ls "$BASE" 2>&1 | head -5 >> $LOG
  done
fi
echo "[postinst] found bundles=$NB execs=$NE" >> $LOG
if [ "$NB" -eq 0 ]; then
  echo "[postinst] tools check:" >> $LOG
  ls -la /usr/libexec/PlistBuddy >> $LOG 2>&1
  ls -la /usr/bin/plutil >> $LOG 2>&1
  ls -la /bin/plutil >> $LOG 2>&1
  CNT=0
  for UUIDDIR in /var/containers/Bundle/Application/*/; do
    CNT=$((CNT+1))
    if [ $CNT -gt 2 ]; then break; fi
    echo "[postinst] uuid dir: $UUIDDIR" >> $LOG
    ls "$UUIDDIR" >> $LOG 2>&1
    for APPD in "$UUIDDIR"*.app; do
      [ -d "$APPD" ] || continue
      echo "[postinst] appdir: $APPD" >> $LOG
      ls "$APPD" | head -5 >> $LOG 2>&1
      /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APPD/Info.plist" >> $LOG 2>&1
      plutil -extract CFBundleIdentifier raw "$APPD/Info.plist" >> $LOG 2>&1
      break
    done
  done
fi
cat /rootfs/var/mobile/unikey_tb.tmp >> /rootfs/var/mobile/unikey_out.tmp
echo ");" >> /rootfs/var/mobile/unikey_out.tmp
echo "Executables = (" >> /rootfs/var/mobile/unikey_out.tmp
cat /rootfs/var/mobile/unikey_te.tmp >> /rootfs/var/mobile/unikey_out.tmp
echo "); }; }" >> /rootfs/var/mobile/unikey_out.tmp
JB=$(ls -d /var/containers/Bundle/Application/.jbroot-* 2>/dev/null | head -1)
cp /rootfs/var/mobile/unikey_out.tmp "$JB/Library/MobileSubstrate/DynamicLibraries/UniKeyApp.plist" 2>> $LOG
echo "[postinst] whitelist written cp_exit=$?" >> $LOG
chmod 644 "$JB/Library/MobileSubstrate/DynamicLibraries/UniKeyApp.plist" 2>> $LOG
rm -f /rootfs/var/mobile/unikey_tb.tmp /rootfs/var/mobile/unikey_te.tmp /rootfs/var/mobile/unikey_out.tmp
echo "[postinst] done" >> $LOG
exit 0
